{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/archiver-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "Archival": {
    "CronSchedule": "0 2 * * *",
    "MaxParallelism": 4,
    "AgeDaysThreshold": 90,
    "FolderSizeMbThreshold": 500,
    "DeleteOriginalsAfterArchive": false,
    "SourceUncRoot": "\\\\DTAZRCRMWBWV01\\CRMFileUpload\\incident",
    "ArchiveUncPath": "\\\\DTAZRCRMWBWV01\\CRMFileArchive\\incident",
    "RetryCount": 3,
    "RetryDelaySeconds": 5,
    "CrmBatchSize": 100,
    "DryRun": false
  },
  "Crm": {
    "ServiceUrl": "https://yourorg.crm.dynamics.com/api/data/v9.2/",
    "IsIfd": false,
    "AdfsUrl": "",
    "ClientExternal": "",
    "ClientInternal": "",
    "Name": "",
    "Code": ""
  }
}
